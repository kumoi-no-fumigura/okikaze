 "poems": [
  {
   "seq": "1",
   "text": "春風は花のあたりをよきてふけ心つからやちりけるとみん",
   "kana": "",
   "speaker": "興風集",
   "page": 509,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春霞たな引野への若なにもなりみてしかな人もつむやと",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "櫻花ちくさなからにあたたれとたれかは春をうらみはてたる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春霞色のちくさにみえつるはたな引のへの花のかけかも",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山風の花の香さそふ麓には春の霞そほたし成ける",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "きつゝのみ鳴鶯の故里はちるにも梅のはなにそありける",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "いたつらにすくる月日は多けれと花みてくらす春そすくなき",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "聲絕すなけや鶯一とせにふたゝひとたにくへきはるかは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "むつましくかこひへたてぬ杜若誰かたにかはうつろひぬへき",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "をるからに我名は立ぬ女郞花いさおなしくははな〓〓とみむ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "ちきりけん心そつらき棚機の年に一たひあふはあふかは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "白波に秋の木葉のうかへるをあまのなかせる舟かとそみる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "木葉ちる浦に波たつ秋なれは紅葉に花もさきまかひけり",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あたらしく我のみやみん菊の花うつらぬさきにみん人もかな",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "山河の菊の下水いかなれはなかれて人の老をせくらむ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "み山よりおちくる瀧の色みてそ秋はかきりとおもひしりぬる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "浦ちかく降くる雪は白波の末のまつやまこすかとそみる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "君こふる淚の床にみちぬれは身をつくしとそ我は成ぬる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "ゑぬる命いきもやすると心みに玉の〓はがりあひみてしかな",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "わひぬれはしひで忘れんと思へとも夢といふ物そ人賴めなる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あふまてのかたみとて社とゝめける淚に浮ふもくつなりけり",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "恨てもなきてもいはん人そなき鏡にみゆるかけならすして",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "我戀をしらんとならは田子の浦にたつらん波の數をかそへよ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "思ひにはきゆる物そとしりなからけさしも何におきてきつ覽",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "何かその名の立〓とは惜からむしりてまとふは我ひとりかは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "身をはかつおもふ物から戀といへはもゆる中にもいる心かな",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "身はすてつ心をたにも失はしつひにはいかゝなるとしるへく",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "たれをかも知人にせん高砂の松もむかしの友ならなくに",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "鶯はあさむきやせん白雪の花とみるまてえたにふれゝは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "うすくこき色は分ねと花といへはひとつかほにもみえ渡る哉",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "あかすして過ゆく春に便りあらは〓としはかりの宿やからなん",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "山里は春のほたしにとちられてすみかまとへる鶯そなく",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "夏の夜の月は程なく明なからあしたのまをそかこちよせつる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "夏の月光りをしますてる時はなかるゝ水にかけろふそたつ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "秋のゝの露におかるゝ女郞花はらふ人なみわひつゝやふる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "女郞花はなの心のあたなれは秋にのみこそあひわたりけれ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "山の井は水なきとそみえわかぬ秋のもみちのちりてかくせは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "大空の月の光にあしからの山のこなたはあきにそありける",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "小倉山秋のもみちは散にしをてりてそみゆるしきにしけれは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "あらし吹山のふもとに降雪はとくちる櫻の花かとそみる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "白波にをりはへあまのこし舟は命にかふるみるめかりにか",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "夢にたに人の思ひにまかせなんみては心のなくさまん物を",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "淚川そこはかゝみにきよけれと戀しき人のかけもみえぬは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "戀しとも今は思はすたましひもあひみぬさきになく成ぬれは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "あひ見てもかひなかりけりうは玉のはかなき夢におとる現は",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "あしたつの何れのあさかなかさらむ思ふ心のゆかぬかきりは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "夢にたにあひみぬなから消ねとや戀しき〓とのこゝにせむらん",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "なきわひて身を空蟬と成ぬれはうらむる〓とも今はきこえす",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "わひぬれはしひて忘れんと思へとも夢てふ物そ人たのめなる",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "うきてぬる鴨の上毛におく霜の消て物思ふころにもあるかな",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "萎れてもあはれたとへてなくさめしなからの橋も今は聞えす",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "戀しきに身もなけつへし慰むることにしたかふ心ならねは",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "浦ちかく立朝霧はもしほやく煙とのみそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "つくはれの蔭におひにし里なれは光りのおほふ物とたにみす",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "雲の上にあとふみとむる濵千鳥行衞もなしとなきのみそする",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "みつれとも心もゆかぬ夢ちをははかなき物とむへもいひけり",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "なけきこるをのゝ響の聞えぬは山のやま彥いつちいにしそ",
   "kana": "",
   "speaker": "",
   "page": 510,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
